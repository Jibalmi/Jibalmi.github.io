{"t": "event", "kind": "speech", "tMs": 54114, "route": "/settings/devices/:id", "role": "caption", "text": "Every change is a revision, and an entry in the computer's hash-chained audit."}
{"t": "event", "kind": "navigate", "tMs": 59947, "route": "/network", "status": 200}
{"t": "event", "kind": "speech", "tMs": 61411, "route": "/network", "role": "caption", "text": "The network room: computers first, the hub on top, each computer's agents beneath it, per platform."}
{"t": "event", "kind": "click", "tMs": 65044, "route": "/network", "selector": "Agents by computer", "componentText": "AGENTS BY COMPUTER", "redacted": false, "bbox": {"x": 977.21875, "y": 82, "width": 135, "height": 28}, "frame": "008.jpg"}
